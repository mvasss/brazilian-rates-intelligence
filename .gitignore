# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
ENV/
env/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs and secrets
*.log
.env

# Raw caching (intermediate HTTP / BCB cache files)
data/raw/cache_*
data/raw/*.parquet
data/raw/*.meta
!data/raw/.gitkeep
!data/events/.gitkeep
